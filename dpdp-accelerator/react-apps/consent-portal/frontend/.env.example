# Base URL the SPA uses to call the BFF. Only an absolute http(s) URL is
# honoured (cross-origin BFF during development). A path-only or empty value
# means the BFF serves the SPA, and the base is detected from the browser URL
# at runtime instead - /consent-portal or /t/<tenant>/consent-portal.
VITE_API_BASE_URL=/consent-portal
# Public base path the SPA is served from (Vite `base`).
VITE_BASE_PATH=/consent-portal/
VITE_AUTH_ENABLED=true
VITE_AUTH_ACCESS_TOKEN_PART1_COOKIE=portal-at-p1
VITE_AUTH_REFRESH_TOKEN_PART1_COOKIE=portal-rt-p1
VITE_AUTH_ID_TOKEN_PART1_COOKIE=portal-id-p1
VITE_AUTH_ID_TOKEN_PART2_COOKIE=portal-id-p2
# Origins the portal may navigate to on logout (the Identity Server host).
VITE_AUTH_LOGOUT_ALLOWED_ORIGINS=https://localhost:9443
